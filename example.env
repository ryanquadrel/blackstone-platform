# ---------------------------------------------------------------------------
# Default model — Blackstone vLLM cluster (Qwen3.5-122B on spark-1).
# `app.settings.default_model()` reads these. Override the URL/model for
# a different deployment; leave api_key alone unless your endpoint requires
# auth.
# ---------------------------------------------------------------------------
# VLLM_BASE_URL=http://spark-1:8000/v1
# VLLM_MODEL_ID=Qwen/Qwen3.5-122B-A10B-FP8
# VLLM_API_KEY=not-required
# VLLM_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Optional — OpenAI. Required ONLY if an agent uses OpenAI directly OR if
# you wire a Knowledge base (db.create_knowledge uses OpenAIEmbedder).
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-***

# ---------------------------------------------------------------------------
# Optional — Claude (anthropic SDK). Add via:
#   from agno.models.anthropic import Claude
#   model=Claude(id="claude-sonnet-4-6", api_key=...)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Production — JWT verification for AgentOS RBAC.
# AgentOS enables RBAC whenever RUNTIME_ENV=prd (the default outside dev).
# Without this key, prod refuses to serve traffic. Generate the keypair at
# os.agno.com (your OS → Settings → Token Based Authorization) after your
# first deploy fails. Paste the full PEM block, no surrounding quotes.
# Set `authorization=False` in app/main.py to opt out (not recommended).
# ---------------------------------------------------------------------------
# JWT_VERIFICATION_KEY=-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkq...
# -----END PUBLIC KEY-----

# ---------------------------------------------------------------------------
# AgentOS scheduler base URL. Defaults to http://127.0.0.1:8000 for local
# development. When AgentOS is deployed to a different domain, set this to
# the public URL.
# ---------------------------------------------------------------------------
# AGENTOS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Host port mappings. Override when something else on the host owns the
# default port (e.g. on EdgeXpert, vLLM owns 8000 — set AGENTOS_PORT=8765).
# Container-internal ports (8000 for the API, 5432 for db) never change.
# ---------------------------------------------------------------------------
# AGENTOS_PORT=8000
# DB_PORT_HOST=5432

# ---------------------------------------------------------------------------
# Web search — WebSearch Agent uses Parallel's MCP server.
#   PARALLEL_API_KEY set  →  authenticated /mcp endpoint (higher rate ceiling)
#   unset                 →  keyless /mcp endpoint (good for dev)
# ---------------------------------------------------------------------------
# PARALLEL_API_KEY=

# ---------------------------------------------------------------------------
# Slack — set both to enable the Slack interface.
#   SLACK_BOT_TOKEN       Bot User OAuth Token (xoxb-***)
#   SLACK_SIGNING_SECRET  Signing Secret (Basic Information → App Credentials)
# ---------------------------------------------------------------------------
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Telegram — set BOTH to enable the Agno Telegram interface (webhook-only).
# For Blackstone use the @blackstone_autoship_bot token, NOT the existing
# notification bot. See docs/decisions/0001-telegram-two-bots.md.
#
# TELEGRAM_ALLOWED_CHAT_IDS is fail-closed: if TELEGRAM_TOKEN is set but
# this parses to an empty set (incl. just whitespace or only commas),
# AgentOS refuses to start. Comma-separated integer chat ids only.
# Find your chat id by messaging the bot then visiting
# https://api.telegram.org/bot<TOKEN>/getUpdates
#
# TELEGRAM_WEBHOOK_SECRET_TOKEN is Agno's OWN second-layer protection —
# in prd (RUNTIME_ENV!=development) Agno's webhook handler validates the
# X-Telegram-Bot-Api-Secret-Token header against this value. Set it AND
# pass it when registering the webhook URL with Telegram:
#   curl -X POST https://api.telegram.org/bot<TOKEN>/setWebhook \
#        -d url=https://<PUBLIC_HOST>/telegram/webhook \
#        -d secret_token=<TELEGRAM_WEBHOOK_SECRET_TOKEN>
# Without it, prod requests will 403 from Agno even after passing our
# chat-id whitelist.
# ---------------------------------------------------------------------------
# TELEGRAM_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=8510846692,…
# TELEGRAM_WEBHOOK_SECRET_TOKEN=<random-string-32+-chars>

# ---------------------------------------------------------------------------
# Database — local development defaults match docker compose
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg

# ---------------------------------------------------------------------------
# Database — production: Supabase session pooler.
# Use the SESSION pooler (port 5432), NOT the transaction pooler (port 6543):
# transaction pooler breaks prepared statements and multi-statement transactions
# (Agno keeps long-lived connections; our migrations are multi-statement).
# Direct connection (db.<ref>.supabase.co:5432) works too but is IPv6-only,
# which Docker containers can't reach by default.
# ---------------------------------------------------------------------------
# DB_HOST=aws-1-us-west-2.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.<project-ref>
# DB_PASS=<from-supabase-dashboard>
# DB_DATABASE=postgres
