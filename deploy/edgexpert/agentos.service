[Unit]
Description=Blackstone Auto-Ship Agent Platform (AgentOS)
Documentation=https://github.com/ryanquadrel/blackstone-platform
# systemd-resolved is added explicitly: network-online.target fires before
# resolved is query-ready, so docker's pull of agnohq/python:3.12 raced and
# lost on three reboots between 2026-05-18 14:32 and 2026-05-19 21:42 UTC.
# See incident_agentos_service_dns_failure_2026_05_20 in memory.
After=docker.service network-online.target systemd-resolved.service
Wants=network-online.target systemd-resolved.service
Requires=docker.service
# Boot-race rate-limit: paired with Restart=on-failure in [Service] below.
# Allow up to 3 ExecStart retries within a 300s window; after that, stop
# retrying so an alarm can investigate something more fundamental.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# AgentOS is run by docker compose; this unit just ensures the stack is up
# on boot and brought down on shutdown. The api container itself has
# restart: always, so crash-loop recovery is Docker's job, not systemd's.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/blackstone-platform
Environment="COMPOSE_FILE=deploy/edgexpert/compose.prod.yaml"
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=600
# Boot-race recovery: if ExecStart exits non-zero (typical cause: DNS not
# yet ready), retry with 30s gaps. Rate-limit is in [Unit] above.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
